# Copia este archivo como .env en la raíz del repositorio y ajusta los valores.
POSTGRES_DB=datasmart
POSTGRES_USER=datasmart
POSTGRES_PASSWORD=cambia-esta-clave

# Para ejecutar fuera de Docker (la API y los scripts leen esta variable):
# DATABASE_URL=postgresql+psycopg2://datasmart:cambia-esta-clave@localhost:5432/datasmart

# URL de la API que usa el dashboard cuando no corre en Compose:
# OLIST_API_URL=http://127.0.0.1:8000
